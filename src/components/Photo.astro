---
// 対話の風景の写真（位置情報などのメタデータは削除済み）
interface Props { eager?: boolean; }
const { eager = false } = Astro.props;
---
<picture>
  <source type="image/webp" srcset="/images/dialogue-800.webp 800w, /images/dialogue-1600.webp 1600w" sizes="(max-width: 900px) 100vw, 1120px" />
  <img
    src="/images/dialogue-1600.jpg"
    srcset="/images/dialogue-800.jpg 800w, /images/dialogue-1600.jpg 1600w"
    sizes="(max-width: 900px) 100vw, 1120px"
    width="1600" height="1200"
    alt="テーブルを囲んで座る参加者たちが、スクリーンに映した言葉を見ながら対話している様子"
    loading={eager ? 'eager' : 'lazy'} decoding="async"
  />
</picture>
