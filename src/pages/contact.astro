---
import Base from '../layouts/Base.astro';
import { SITE, safeUrl, safeEmail } from '../site.config';
const sns = Object.entries(SITE.sns).map(([k, url]) => [k, safeUrl(url)] as const).filter(([, url]) => url);
const formUrl = safeUrl(SITE.contactFormUrl);
const email = safeEmail(SITE.contactEmail);
const labels: Record<string, string> = { instagram: 'Instagram', x: 'X', line: 'LINE公式アカウント' };
---
<Base title="お問い合わせ" description="北九州リハビリテーションハブへのお問い合わせ、取材や協働のご相談はこちらから。">
  <div class="page-head"><div class="container"><h1>お問い合わせ</h1></div></div>

  <section>
    <div class="narrow">
      <div class="block">
        <p class="lead">
          会についての質問、取材、一緒に何かやりたいという相談まで、気軽にどうぞ。
          お名前、メールアドレス、お問い合わせの種類と内容を送ってください。数日以内にお返事します。
        </p>
        <div class="actions">
          {formUrl
            ? <a class="btn" href={formUrl} target="_blank" rel="noopener noreferrer">フォームを開く</a>
            : <span class="btn" aria-disabled="true">フォーム準備中</span>}
        </div>
        {email && <p class="lead mt24">メール <a href={`mailto:${email}`}>{email}</a></p>}
        <p class="mt24">お預かりした個人情報は <a href="/privacy">プライバシーポリシー</a> に沿って取り扱います</p>
      </div>

      {sns.length > 0 && (
        <div class="block">
          <h2>SNS</h2>
          <div class="actions">
            {sns.map(([key, url]) => <a class="btn btn-ghost" href={url} target="_blank" rel="noopener noreferrer">{labels[key]}</a>)}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
