---
import Base from '../layouts/Base.astro';
import { SITE, safeUrl, googleFormEmbedUrl } from '../site.config';
const sns = Object.entries(SITE.sns).map(([k, url]) => [k, safeUrl(url)] as const).filter(([, url]) => url);
const labels: Record<string, string> = { instagram: 'Instagram', x: 'X', line: 'LINE公式アカウント' };
const formUrl = googleFormEmbedUrl(SITE.googleFormUrl);
const openUrl = (() => {
  if (!formUrl) return null;
  const u = new URL(formUrl);
  u.searchParams.delete('embedded');
  return u.href;
})();
---
<Base title="お問い合わせ・参加申込" description="北九州リハビリテーションハブ研究会へのお問い合わせ、本質観取の会への参加申込はこちらから。">
  <div class="page-head"><div class="container"><h1>お問い合わせ</h1></div></div>

  <section>
    <div class="narrow">
      <p class="lead">
        本質観取の会への参加申込、会についての質問、取材、一緒に何かやりたいという相談まで、こちらのフォームからどうぞ。数日以内にお返事します。
      </p>

      <div id="form" class="gform">
        {formUrl ? (
          <iframe src={formUrl} title="お問い合わせ・参加申込フォーム" loading="lazy" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox">読み込んでいます…</iframe>
        ) : (
          <p class="lead tc">フォームは準備中です</p>
        )}
      </div>
      {openUrl && (
        <p class="mt24 tc">フォームがうまく表示されないときは <a href={openUrl} target="_blank" rel="noopener noreferrer">こちらから開いてください</a></p>
      )}
      <p class="mt24">送信内容は <a href="/privacy">プライバシーポリシー</a> に沿って取り扱います。</p>

      {sns.length > 0 && (
        <div class="block mt24">
          <h2>SNS</h2>
          <div class="actions">
            {sns.map(([key, url]) => <a class="btn btn-ghost" href={url} target="_blank" rel="noopener noreferrer">{labels[key]}</a>)}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>
