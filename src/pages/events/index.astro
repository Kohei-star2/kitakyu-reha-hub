---
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { getUpcoming } from '../../lib/events';
const upcoming = await getUpcoming();
---
<Base title="開催案内" description="本質観取の会の開催日時、場所、テーマと申込方法のご案内です。">
  <div class="page-head"><div class="container"><h1>開催案内</h1></div></div>

  <section>
    <div class="container">
      {upcoming.length > 0 ? (
        <div class="event-list">{upcoming.map((e) => <EventCard event={e} />)}</div>
      ) : (
        <p class="lead">いま募集中の会はありません。次回の日程は決まり次第お知らせします</p>
      )}
    </div>
  </section>

  <section class="pt0">
    <div class="container">
      <h2 class="section-title">申し込みの流れ</h2>
      <ol class="steps">
        <li><h3>フォームに入力</h3><p>各回の申込ボタンから、お名前と連絡先を送ってください</p></li>
        <li><h3>案内メールが届く</h3><p>会場の詳細やオンラインのURLをお送りします</p></li>
        <li><h3>当日参加</h3><p>持ち物は特にありません。気軽にお越しください</p></li>
        <li><h3>終わったあと</h3><p>言葉になった本質は開催報告にまとめて公開します</p></li>
      </ol>
      <div class="actions"><a href="/faq" class="btn btn-ghost">はじめての方へ</a></div>
    </div>
  </section>
</Base>
