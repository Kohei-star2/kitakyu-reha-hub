---
import Base from '../layouts/Base.astro';
const faqs = [
  ['医療職でなくても参加できますか？', 'はい、参加できます。リハビリ職・看護師・医師・相談員などの医療職の方に加えて、学生の方、介護職の方、患者さんやご家族の立場の方など、どなたでも歓迎しています。'],
  ['哲学の知識は必要ですか？', '必要ありません。本質観取は、専門的な知識ではなく、ご自身の体験をもとに考える対話です。'],
  ['うまく話せるか不安です。', '話したくないときはパスできます。聴いているだけでも大丈夫です。進行役がいるので、安心してご参加ください。'],
  ['一人で参加しても大丈夫ですか？', 'はい。ほとんどの方がお一人で参加されています。会の最初に自己紹介の時間があります。'],
  ['持ち物はありますか？', '特にありません。メモを取りたい方は筆記用具をお持ちください。'],
  ['患者さんの事例を話してもいいですか？', '個人が特定できない範囲でお話しください。会で聞いた個人的な話は、外に持ち出さないお約束をしています。'],
  ['参加費はかかりますか？', '回によって異なります。各回の開催案内をご確認ください。'],
];
---
<Base title="初めての方へ・Q&A" description="本質観取の会に初めて参加する方へ。参加条件、持ち物、よくある質問をまとめています。">
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">FOR BEGINNERS</span>
      <h1>初めての方へ・Q&amp;A</h1>
      <p>医療職の方も、そうでない方も、どなたでも参加できます。</p>
    </div>
  </div>

  <section>
    <div class="container grid-3">
      <div class="card"><div class="value-num">誰でも</div><h3>参加できます</h3><p>医療職、学生、一般の方まで。職種や経験年数は問いません。</p></div>
      <div class="card"><div class="value-num">知識</div><h3>は要りません</h3><p>自分の体験をもとに話す対話です。予習は不要です。</p></div>
      <div class="card"><div class="value-num">パス</div><h3>もできます</h3><p>話したくないときは聴いているだけでも大丈夫です。</p></div>
    </div>
  </section>

  <section class="section-mist">
    <div class="narrow faq">
      <h2>よくある質問</h2>
      {faqs.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
