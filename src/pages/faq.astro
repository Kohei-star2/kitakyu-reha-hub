---
import Base from '../layouts/Base.astro';
const faqs = [
  ['医療職でなくても参加できますか', 'できます。リハビリ職、看護師、医師、相談員などの医療職に加えて、学生、介護職、患者さんやご家族の立場の方など、どなたでも歓迎しています。'],
  ['哲学の知識は必要ですか', '必要ありません。本質観取は、専門知識ではなく自分の体験をもとに考える対話です。'],
  ['うまく話せるか不安です', '話したくないときはパスできます。聴いているだけでも大丈夫です。進行役がいるので安心してください。'],
  ['一人で参加しても大丈夫ですか', '大丈夫です。最初に自己紹介の時間があります。'],
  ['持ち物はありますか', '特にありません。メモを取りたい方は筆記用具をどうぞ。'],
  ['患者さんの事例を話してもいいですか', '個人が特定できない範囲でお話しください。会で聞いた個人的な話は外に持ち出さないお約束をしています。'],
  ['参加費はかかりますか', '回によって異なります。各回の開催案内をご確認ください。'],
];
---
<Base title="はじめての方へ" description="本質観取の会にはじめて参加する方へ。参加条件、持ち物、よくある質問をまとめています。">
  <div class="page-head"><div class="container"><h1>はじめての方へ</h1></div></div>

  <section>
    <div class="container">
      <div class="big3">
        <div><h3>誰でも参加OK</h3><p>医療職、学生、一般の方まで。職種や経験年数は問いません</p></div>
        <div><h3>知識はいらない</h3><p>自分の体験をもとに話す対話です。予習も不要です</p></div>
        <div><h3>パスもできる</h3><p>話したくないときは聴いているだけで大丈夫です</p></div>
      </div>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="narrow faq">
      <h2 class="section-title">よくある質問</h2>
      {faqs.map(([q, a]) => (
        <details><summary>{q}</summary><p>{a}</p></details>
      ))}
    </div>
  </section>
</Base>
