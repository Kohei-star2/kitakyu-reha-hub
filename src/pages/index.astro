---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { getUpcoming, getPast, formatDate, bigDate } from '../lib/events';

const upcoming = await getUpcoming();
const next = upcoming[0];
const nextDate = next ? bigDate(next.data.date) : null;
const reports = (await getPast()).slice(0, 4);
const questions = ['連携とは何か', '回復とは何か', '寄り添うとは何か', '顔の見える関係とは何か', '専門性とは何か', 'チームとは何か'];
---
<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1><span>ちがう職種で</span><span><span class="accent">同じ問い</span>を</span></h1>
        <p class="hero-lead">
          北九州リハビリテーションハブは、北九州市の医療職が顔の見える関係でつながるための任意団体です。
          哲学対話「本質観取の会」を開いています。
        </p>
        <div class="actions">
          <a href="/events" class="btn">次回の会に申し込む</a>
          <a href="/honshitsu" class="btn btn-ghost">本質観取って何</a>
        </div>
      </div>
      <div class="venn" aria-hidden="true">
        <span class="c1"></span><span class="c2"></span>
        <b class="label l1">職種A</b><b class="label l2">職種B</b><b class="label l3">同じ<br />問い</b>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...questions, ...questions].map((q) => <span>{q}</span>)}
    </div>
  </div>

  <section>
    <div class="container">
      <h2 class="section-title">次の対話</h2>
      {next && nextDate ? (
        <div class="next">
          <div class="bigdate"><span class="md">{nextDate.md}</span><span class="wd">{nextDate.wd}</span></div>
          <EventCard event={next} />
        </div>
      ) : (
        <p class="lead">次回の日程は決まり次第ここでお知らせします</p>
      )}
      {upcoming.length > 1 && <div class="actions"><a href="/events" class="btn btn-ghost">ほかの日程も見る</a></div>}
    </div>
  </section>

  <section class="vision">
    <div class="container">
      <h2>北九州の医療職が<br />顔の見える<br />ほんとうの連携をできるように</h2>
      <div class="pillars">
        <div>
          <h3>顔が見える</h3>
          <p>名前を知っているだけでなく、あの人ならこう考えると想像できる関係を増やします</p>
        </div>
        <div>
          <h3>職種を越える</h3>
          <p>リハビリ職も看護師も医師も相談員も、同じ問いの前では対等です</p>
        </div>
        <div>
          <h3>本当につながる</h3>
          <p>書類と電話だけの連携から、考え方まで分かり合える連携へ</p>
        </div>
      </div>
      <div class="actions"><a href="/about" class="btn btn-light">私たちについて</a></div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2 class="section-title">本質観取の会で<br />やること</h2>
      <ol class="steps">
        <li><h3>問いを置く</h3><p>連携とは何か、のようなふだん使う言葉をひとつ選びます</p></li>
        <li><h3>体験を話す</h3><p>それぞれの現場で起きた具体的なエピソードを持ち寄ります</p></li>
        <li><h3>共通点を探す</h3><p>ばらばらの体験に通じているものをみんなで探します</p></li>
        <li><h3>言葉にする</h3><p>全員が納得できる一文にまとめて、その日の答えにします</p></li>
      </ol>
      <div class="actions"><a href="/honshitsu" class="btn btn-ghost">くわしく見る</a></div>
    </div>
  </section>

  {reports.length > 0 && (
    <section style="padding-top:0;">
      <div class="container">
        <h2 class="section-title">これまでの問い</h2>
        <ul class="report-list">
          {reports.map((r) => (
            <li>
              <a href={`/reports/${r.id}`}>
                <span class="d">{formatDate(r.data.date)}</span>
                <span class="q">{r.data.question}</span>
                <span class="go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <div class="doors">
    <a href="/faq">
      <h3>はじめての方へ</h3>
      <p>哲学の知識はいりません。一般の方も参加できます</p>
    </a>
    <a href="/contact">
      <h3>お問い合わせ</h3>
      <p>参加の相談、取材、一緒に何かやりたい方はこちら</p>
    </a>
  </div>
</Base>
