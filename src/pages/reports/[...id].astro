---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { whenLabel, questionLabel } from '../../lib/events';

export async function getStaticPaths() {
  const all = (await getCollection('events')).filter((e) => e.data.status === '終了');
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const e = entry.data;
---
<Base title={`${questionLabel(entry)} 開催報告`}>
  <div class="page-head"><div class="container"><h1>{questionLabel(entry)}</h1></div></div>
  <section>
    <article class="narrow prose">
      <table class="info-table" style="margin-bottom:48px;">
        <tbody>
          <tr><th>開催</th><td>{e.title}</td></tr>
          {e.date && <tr><th>日時</th><td>{whenLabel(entry)}</td></tr>}
          {e.format && <tr><th>形式</th><td>{e.format}</td></tr>}
        </tbody>
      </table>
      <Content />
      <div class="actions"><a href="/reports" class="btn btn-ghost">報告の一覧へ</a></div>
    </article>
  </section>
</Base>
