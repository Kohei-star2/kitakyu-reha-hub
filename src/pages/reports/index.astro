---
import Base from '../../layouts/Base.astro';
import { getPast, formatDate, questionLabel } from '../../lib/events';
const past = await getPast();
const tags = [...new Set(past.flatMap((e) => e.data.tags))];
---
<Base title="開催報告" description="これまでの本質観取の会の問いと、対話から言葉になった本質の記録です。">
  <div class="page-head"><div class="container"><h1>開催報告</h1></div></div>

  <section>
    <div class="container">
      {tags.length > 0 && (
        <div class="filter" id="tag-filter">
          <button class="is-on" data-tag="">すべて</button>
          {tags.map((t) => <button data-tag={t}>{t}</button>)}
        </div>
      )}
      {past.length > 0 ? (
        <ul class="report-list">
          {past.map((r) => (
            <li class="report-item" data-tags={r.data.tags.join(',')}>
              <a href={`/reports/${r.id}`}>
                <span class="d">{r.data.title}{r.data.date && ` ${formatDate(r.data.date)}`}</span>
                <span class="q">{questionLabel(r)}</span>
                <span class="go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="lead">開催報告は準備中です</p>
      )}
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('#tag-filter button');
    const items = document.querySelectorAll<HTMLElement>('.report-item');
    buttons.forEach((b) => b.addEventListener('click', () => {
      const tag = b.dataset.tag;
      buttons.forEach((x) => x.classList.toggle('is-on', x === b));
      items.forEach((it) => {
        const show = !tag || (it.dataset.tags || '').split(',').includes(tag);
        it.style.display = show ? '' : 'none';
      });
    }));
  </script>
</Base>
